{
	"manifest_version": 3,
	"name": "SmokeyZ",
	"short_name": "SmokeyZ",
	"version": "0.0.0",
	"description": "Custom emotes, chat features and UI tweaks for Twitch. A community fork of FrankerFaceZ; not affiliated with Twitch.",
	"homepage_url": "https://github.com/smokey019/FrankerFaceZ",
	"minimum_chrome_version": "111",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_title": "SmokeyZ",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png"
		}
	},
	"permissions": [
		"scripting"
	],
	"host_permissions": [
		"*://*.twitch.tv/*"
	],
	"background": {
		"service_worker": "web/worker.js"
	},
	"content_scripts": [
		{
			"matches": [
				"*://*.twitch.tv/*"
			],
			"exclude_matches": [
				"*://api.twitch.tv/*"
			],
			"js": [
				"content.js"
			],
			"run_at": "document_end",
			"all_frames": true
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"web/*"
			],
			"matches": [
				"*://*.twitch.tv/*"
			]
		}
	],
	"externally_connectable": {
		"matches": [
			"*://*.twitch.tv/*"
		]
	}
}
